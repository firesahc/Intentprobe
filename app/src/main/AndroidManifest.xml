<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Intentprobe">

        <!-- LSPosed module identity. Scope is intentionally empty: the user
             ticks probe targets manually in LSPosed. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposeddescription"
            android:value="只读探测应用的 Activity Intent 与静态路由，不修改任何参数" />
        <meta-data
            android:name="xposedminversion"
            android:value="89" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppDetailActivity"
            android:exported="false" />

        <!-- Cross-process ingress for capture events and connection heartbeats.
             Access is enforced in code by caller uid + probe scope. -->
        <provider
            android:name=".data.ProbeProvider"
            android:authorities="com.example.intentprobe.provider"
            android:exported="true" />

    </application>

</manifest>
